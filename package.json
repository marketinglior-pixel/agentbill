{
  "name": "agentbill-api",
  "version": "0.1.0",
  "description": "Usage-based billing infrastructure for AI agent developers",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env node_modules/.bin/tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "psql $DATABASE_URL -f src/db/schema.sql"
  },
  "dependencies": {
    "@fastify/sensible": "^5.6.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.0",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
