{
  "name": "agentbill-api",
  "version": "0.1.0",
  "description": "Usage-based billing infrastructure for AI agent developers",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env node_modules/.bin/tsx watch src/server.ts",
    "dev:local": "node --env-file=.env.local node_modules/.bin/tsx watch src/server.ts",
    "build": "tsc",
    "build:og": "./scripts/og/build.sh",
    "start": "node dist/server.js",
    "deploy": "./scripts/deploy.sh",
    "db:migrate": "psql $DATABASE_URL -f src/db/schema.sql",
    "check:snippets": "./scripts/snippets/run.sh repo",
    "check:snippets:published": "./scripts/snippets/run.sh published",
    "check:ratchet": "node scripts/ratchet/run.mjs",
    "check:hygiene": "./scripts/hygiene/run.sh",
    "check:urls": "./scripts/seo/urls.sh",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/etag": "^6.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "postgres": "^3.4.4",
    "resend": "^6.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
