# PostgreSQL connection string (Supabase, Railway Postgres, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentbill

# API key — SDKs send this as: Authorization: Bearer <key>
# Generate one: openssl rand -hex 32
AGENTBILL_API_KEY=

# Single-account MVP: the UUID of your account row in the accounts table
# Run: INSERT INTO accounts DEFAULT VALUES RETURNING id;
HARDCODED_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# Default budget (units) assigned to new customers on first event
HARDCODED_DEFAULT_BUDGET=100

PORT=3000
