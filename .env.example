# PostgreSQL connection string (Supabase, Railway Postgres, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentbill

# API key — SDKs send this as: Authorization: Bearer <key>
# Generate one: openssl rand -hex 32
AGENTBILL_API_KEY=

# Single-account MVP: the UUID of your account row in the accounts table
# Run: INSERT INTO accounts DEFAULT VALUES RETURNING id;
HARDCODED_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# Default budget (units) assigned to new customers on first event
HARDCODED_DEFAULT_BUDGET=100

PORT=3000

# Polar billing (https://polar.sh — create a product + meter, then copy these)
POLAR_API_KEY=
POLAR_METER_SLUG=
POLAR_CHECKOUT_URL=
POLAR_ORG_SLUG=
POLAR_WEBHOOK_SECRET=

# Resend (https://resend.com, for every email the app sends)
#
# Leave this EMPTY locally. The server loads this file (dotenv/config in
# src/server.ts:1), and the preflight harness registers a throwaway account on
# every run, so a real key here sends real mail to OWNER_ALERT_EMAIL each time
# the harness runs. Every mailer in src/lib is a no-op without it, which is why
# the harness is safe today.
RESEND_API_KEY=

# Where owner alerts go: a new signup, a quota threshold, a rejected Polar
# webhook, a new network on a key, the daily digest. Skipped if unset.
OWNER_ALERT_EMAIL=

# The From address on every email. Unset falls back to onboarding@resend.dev,
# which is a DIFFERENT sending domain from production's and so a different
# deliverability reputation. Set it to match production before reading anything
# into a local send.
RESEND_FROM=

# Secret for the /admin dashboard. Generate one: openssl rand -hex 32
ADMIN_SECRET=
